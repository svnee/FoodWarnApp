{
  "name": "foodwarnlux-backend",
  "version": "1.0.0",
  "description": "Backend middleware and API for FoodWarnLux - Luxembourg food recall scanner",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
